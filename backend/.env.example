# LoginGuard Backend Configuration
PORT=3000
NODE_ENV=development

# Google Safe Browsing v4 API Key (Optional, keeps key off client extension)
SAFE_BROWSING_API_KEY=

# Allowed CORS Origins (leave * for all or specify chrome-extension://<id>)
ALLOWED_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
